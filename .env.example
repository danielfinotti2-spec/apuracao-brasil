# Fiscaliza Brasil — variáveis de ambiente
#
# Todas as fontes de dados políticos (Câmara, Senado, IBGE) são públicas e sem
# autenticação. As variáveis abaixo ligam recursos que hoje têm fallback honesto.

# Banco Postgres (quadro público de melhorias). Na Vercel: Storage → Postgres,
# que já injeta POSTGRES_URL automaticamente. Localmente, copie o valor do painel.
POSTGRES_URL=
DATABASE_URL=

# Futuros: fila de sincronização e provedor de IA (ainda não usados no código)
REDIS_URL=
AI_PROVIDER_API_KEY=
