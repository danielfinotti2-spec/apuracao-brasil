# Fiscaliza Brasil — variáveis de ambiente
#
# Todas as fontes de dados políticos (Câmara, Senado, IBGE) são públicas e sem
# autenticação. As variáveis abaixo ligam recursos que hoje têm fallback honesto.

# Banco Postgres (quadro público de melhorias). Na Vercel: Storage → Postgres,
# que já injeta POSTGRES_URL automaticamente. Localmente, copie o valor do painel.
POSTGRES_URL=
DATABASE_URL=

# Supabase (contador de visitas agregado: apenas dia + página, sem IP/cookie).
# 1. crie o projeto grátis em https://supabase.com
# 2. rode supabase/schema.sql no SQL Editor do projeto
# 3. copie a URL e a service_role key em Settings → API
# 4. configure estas duas envs na Vercel e faça Redeploy
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chave para registrar casos comprovados no /api/scandals (POST administrativo)
SCANDAL_ADMIN_KEY=

# Futuros: fila de sincronização e provedor de IA (ainda não usados no código)
REDIS_URL=
AI_PROVIDER_API_KEY=
